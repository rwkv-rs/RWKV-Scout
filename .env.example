# OpenAI-compatible RWKV endpoint
RWKV_ECRA_LLM_BASE_URL=http://127.0.0.1:29613/v1
RWKV_ECRA_LLM_API_KEY=replace-with-local-api-key
RWKV_ECRA_LLM_MODEL=rwkv7-g1i-13.3b-20260805-ctx16384
RWKV_ECRA_LLM_CONTEXT_LENGTH=16384
# Optional when the extraction endpoint uses a different credential. If empty,
# the SLM client falls back to RWKV_ECRA_LLM_API_KEY.
RWKV_ECRA_SLM_PASSWORD=

# Optional request-level default. Stage-specific temperatures are configured
# under MODEL_RUNTIME.sampling in config.json.
RWKV_ECRA_LLM_TEMPERATURE=0.00001
# RWKV_ECRA_PLANNER_TEMPERATURE=0.1
# RWKV_ECRA_PLANNER_REPLAN_TEMPERATURE=0.25
# RWKV_ECRA_PLANNER_REPLAN_INCREMENT_TEMPERATURE=0.1
# RWKV_ECRA_PLANNER_REPLAN_MAX_TEMPERATURE=0.55
# RWKV_ECRA_CROSS_VALIDATION_TEMPERATURE=0.1

# Optional search providers
TAVILY_API_KEY=
TAVILY_API_KEYS=[]
RWKV_ECRA_WIGOLO_MODE=auto
WIGOLO_BASE_URL=http://127.0.0.1:3333

# API server
RWKV_ECRA_API_HOST=0.0.0.0
RWKV_ECRA_API_PORT=8787
RWKV_ECRA_API_WORKERS=1
# Set to 1 only on the tunnel-facing deployment. Public mode exposes the
# analyze/events/report/stop allowlist and disables management endpoints.
RWKV_ECRA_PUBLIC_MODE=0

# Direct RWKV runtime (only when MODEL_RUNTIME.backend=direct_rwkv)
RWKV_ECRA_RWKV_ENGINE_ROOT=
RWKV_ECRA_RWKV_MODEL_PATH=
RWKV_ECRA_RWKV_VOCAB_PATH=
RWKV_ECRA_RWKV_DEVICE=cuda
