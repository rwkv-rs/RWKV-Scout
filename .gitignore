# 1. 默认忽略仓库中的所有文件和目录
*

# 2. 允许 Git 遍历所有目录（必须保留此行，否则子目录里的文件将无法被识别）
!*/

# 3. 仅允许上传以下指定扩展名的文件
!*.md
!*.py
!*.txt
!*.png
!*.jpg
!*.json
!pyproject.toml

# 4. （可选）如果你希望 .gitignore 文件本身也能被提交并同步到仓库，请保留下面这行：
!.gitignore
!.gitattributes

# 5. Frontend app
!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
debug_slm/
logs/
package-lock.json
data/output/
!data/
!data/evaluation/
!data/evaluation/**

# Local Python/runtime artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example

# Reproducible dependency locks
!uv.lock
!frontend/package-lock.json

# Generated evaluation and audit artefacts stay local.  Keep only the
# canonical input suites needed to reproduce the archived benchmark.
outputs/
data/archive/
data/evaluation/**
!data/evaluation/date_retrieval_tasks_20260729.jsonl
!data/evaluation/rwkv_search_100_fixed_20260729.json
!data/evaluation/rwkv_search_50_fixed_20260729.json
!data/evaluation/url_summary_tasks_20260731.json
!data/evaluation/random_40_from_172_20260806.json
!data/evaluation/remaining_132_from_172_20260807.json
!data/evaluation/interference_40_query_only_20260808.json
!data/evaluation/retrieval_required_100_20260808.json
!data/evaluation/preflight_smoke_10.jsonl

# Local frontend/build artefacts
frontend/node_modules/
frontend/dist/

# Editor and assistant metadata are not runtime dependencies.
.agents/
.claude/
.cursor/
.idea/
.vscode/
